# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
.venv/
venv/
env/
.env

# --- Рантайм-артефакты приложения (личные данные, локальные пути) ---
# progress.json — прогресс обработки: содержит абсолютные пути и капшены
progress.json
# processing_log.txt — лог прогонов
processing_log.txt
# settings.json — «липкие» настройки UI (в т.ч. trigger_word)
settings.json
# presets.json — пользовательские пресеты; пример см. presets.example.json
presets.json
# stoplist.txt — личный стоп-лист тегов (создаётся в корне при сохранении в UI)
stoplist.txt

# --- Датасеты / выходные .txt рядом с картинками ---
*.jpg
*.jpeg
*.png
*.webp

# ...но скриншоты для README в docs/ — исключение
!docs/*.png

# --- Бэкапы капшенов от массовых операций ---
*.bak

# --- IDE / ОС ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Локальная карта проекта для Claude Code (личное, не публикуем) ---
CLAUDE.md

# --- Рабочие заметки по планам (личное, не публикуем) ---
PLAN_STATUS.md
FINAL_IMPLEMENTATION_PLAN.md
UX_INTERFACE_IMPROVEMENT_PLAN.md
Phase X*.txt
Интерфейс*.txt
.tmp-check/
.tmp-edge/

# Development-only material (not part of releases)
tests/
frontend/src/**/*.test.*
frontend/src/test/
scripts/
UX_UI_PROPOSAL.md
docs/ARCHITECTURE_MIGRATION_PLAN.md
docs/UI_REQUIREMENTS_TRACEABILITY.md
*проверка*.txt
# Managed llama.cpp binaries, resumable downloads and runtime logs
llama/
llama-server.log
llama-*.log
live-test-processing.log
backend_profiles.json
.tagmanager-service/
taggers/

# Local Agent Router credentials. The launcher may write an auth token here.
agentrouter-config.json
